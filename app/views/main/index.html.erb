<section class="page-heading">
  <div>
    <p class="eyebrow">MY NOTES</p>
    <h1>このブラウザで開いたノート。</h1>
    <p>ここにある内容は一時的です。大切なノートは編集画面からJSONバックアップを保存してください。</p>
  </div>
  <%= link_to '＋ 新しいマンダラート', new_main_path, class: 'button' %>
</section>

<% if @records.any? %>
  <section class="record-grid" aria-label="マンダラート一覧">
    <% @records.each do |record| %>
      <% data = record.data || {} %>
      <article class="record-card">
        <div class="record-card__number"><%= format('%02d', record.id) %></div>
        <p class="eyebrow">MANDALA NOTE</p>
        <h2><%= data['goal'].presence || '無題の目標' %></h2>
        <p class="record-card__date">作成日 <%= l(record.created_at.to_date, format: :long) %></p>
        <div class="record-card__actions">
          <%= link_to '開く →', edit_main_path(token: record.access_token), class: 'text-link' %>
          <%= button_to '削除', delete_main_path(token: record.access_token), method: :delete, class: 'quiet-button', data: { turbo_confirm: 'このマンダラートを削除しますか？' } %>
        </div>
      </article>
    <% end %>
  </section>
<% else %>
  <section class="empty-state">
    <p class="eyebrow">FIRST NOTE</p>
    <h2>最初の目標を書いてみよう。</h2>
    <p>新しいノートを作るか、JSONバックアップから再開できます。</p>
    <%= link_to 'マンダラートを作る', new_main_path, class: 'button' %>
  </section>
<% end %>
