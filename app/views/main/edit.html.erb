<% data = @record.data || {} %>
<% groups = [[1, 2, 3], [4, nil, 5], [6, 7, 8]] %>
<section class="editor-header">
  <div>
    <%= link_to '← マイノート', main_index_path, class: 'back-link' %>
    <p class="eyebrow">MANDALA EDITOR</p>
    <h1><%= data['goal'].presence || '無題の目標' %></h1>
    <p>すべてのマスを直接編集できます。小さく具体的な行動に分解していきましょう。</p>
  </div>
</section>

<%= form_with url: update_main_path, method: :patch, class: 'mandala-editor' do %>
  <%= hidden_field_tag :record_id, @record.id %>
  <div class="mandala-board" aria-label="9x9 マンダラート編集盤">
    <% groups.each do |row| %>
      <% row.each do |group| %>
        <% if group %>
          <section class="mandala-group" aria-label="テーマ <%= group %>">
            <% [[1, 2, 3], [4, :theme, 5], [6, 7, 8]].each do |cells| %>
              <% cells.each do |cell| %>
                <% if cell == :theme %>
                  <div class="mandala-cell mandala-cell--theme mandala-cell--readonly"><%= data["main_target#{group}"] %></div>
                <% else %>
                  <label class="mandala-cell mandala-cell--action">
                    <span class="sr-only">テーマ <%= group %> の行動 <%= cell %></span>
                    <%= text_field_tag "target#{group}_#{cell}", data["target#{group}_#{cell}"], placeholder: '具体的な行動' %>
                  </label>
                <% end %>
              <% end %>
            <% end %>
          </section>
        <% else %>
          <section class="mandala-group mandala-group--center" aria-label="中心目標">
            <% groups.each do |center_row| %>
              <% center_row.each do |number| %>
                <% if number %>
                  <label class="mandala-cell mandala-cell--theme">
                    <span class="sr-only">テーマ <%= number %></span>
                    <%= text_field_tag "main_target#{number}", data["main_target#{number}"], placeholder: 'テーマ' %>
                  </label>
                <% else %>
                  <label class="mandala-cell mandala-cell--goal">
                    <span class="sr-only">中心目標</span>
                    <%= text_field_tag :goal, data['goal'], placeholder: '中心目標' %>
                  </label>
                <% end %>
              <% end %>
            <% end %>
          </section>
        <% end %>
      <% end %>
    <% end %>
  </div>
  <div class="editor-actions"><p>入力内容は「保存する」を押すまで反映されません。</p><%= submit_tag '保存する', class: 'button' %></div>
<% end %>
