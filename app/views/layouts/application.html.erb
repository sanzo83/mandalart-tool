<!DOCTYPE html>
<html lang="ja">
  <head>
    <title>Mandala Note</title>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag 'application', media: 'all' %>
    <%= javascript_include_tag 'application', defer: true %>
  </head>
  <body>
    <header class="site-header">
      <div class="site-header__inner">
        <%= link_to root_path, class: 'brand' do %><span class="brand__mark">M</span><span>Mandala Note</span><% end %>
        <button class="menu-button" type="button" aria-expanded="false" aria-controls="site-navigation">メニュー</button>
        <nav id="site-navigation" class="site-navigation" aria-label="メインナビゲーション">
          <%= link_to '一時ノート', main_index_path %>
          <%= link_to 'バックアップを開く', root_path(anchor: 'backup') %>
          <%= link_to '新しく作る', new_main_path, class: 'button button--small' %>
        </nav>
      </div>
    </header>
    <main class="page-shell">
      <% if notice %><p class="flash flash--notice"><%= notice %></p><% end %>
      <% if alert %><p class="flash flash--alert"><%= alert %></p><% end %>
      <%= yield %>
    </main>
  </body>
</html>
