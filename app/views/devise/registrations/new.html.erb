<section class="auth-card">
  <p class="eyebrow">START A NOTE</p>
  <h1>アカウントを作る</h1>
  <%= form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f| %>
    <%= render 'devise/shared/error_messages', resource: resource %>
    <div class="field"><%= f.label :email, 'メールアドレス' %><%= f.email_field :email, autofocus: true, autocomplete: 'email' %></div>
    <div class="field"><%= f.label :password, 'パスワード' %><%= f.password_field :password, autocomplete: 'new-password' %><small><%= @minimum_password_length %>文字以上で設定してください</small></div>
    <div class="field"><%= f.label :password_confirmation, 'パスワード（確認）' %><%= f.password_field :password_confirmation, autocomplete: 'new-password' %></div>
    <%= f.submit '無料ではじめる', class: 'button' %>
  <% end %>
  <div class="auth-links"><%= render 'devise/shared/links' %></div>
</section>
