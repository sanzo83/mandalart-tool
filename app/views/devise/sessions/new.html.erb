<section class="auth-card">
  <p class="eyebrow">WELCOME BACK</p>
  <h1>ログイン</h1>
  <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
    <div class="field"><%= f.label :email, 'メールアドレス' %><%= f.email_field :email, autofocus: true, autocomplete: 'email' %></div>
    <div class="field"><%= f.label :password, 'パスワード' %><%= f.password_field :password, autocomplete: 'current-password' %></div>
    <%= f.submit 'ログイン', class: 'button' %>
  <% end %>
  <div class="auth-links"><%= render 'devise/shared/links' %></div>
</section>
