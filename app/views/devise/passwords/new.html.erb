<section class="auth-card">
  <p class="eyebrow">RESET PASSWORD</p>
  <h1>パスワードを再設定</h1>
  <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post }) do |f| %>
    <%= render 'devise/shared/error_messages', resource: resource %>
    <div class="field"><%= f.label :email, 'メールアドレス' %><%= f.email_field :email, autofocus: true, autocomplete: 'email' %></div>
    <%= f.submit '再設定メールを送る', class: 'button' %>
  <% end %>
  <div class="auth-links"><%= render 'devise/shared/links' %></div>
</section>
